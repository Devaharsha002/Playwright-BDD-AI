{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "src/**/*.ts",
    ".features-gen/**/*.ts",
    "playwright.config.ts",
    "test-results/HSBC-AT-Report/reporter.ts"
  ]
}
